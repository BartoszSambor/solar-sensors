PROJECT_NAME="Solar Sensors"
ENVIRONMENT=dev

# Public host name; Caddy gets a Let's Encrypt certificate for it.
# Locally: certificates from Caddy's local CA; host.docker.internal is how
# containers on this machine (the simulator) reach the app.
SITE_ADDRESS=localhost, host.docker.internal

PG_HOST=db
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DB=solar_sensors

FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin12345

# Simulator: addresses it may send measurements to (first is the default).
# Production: SIMULATOR_API_URLS=https://<SITE_ADDRESS> and SIMULATOR_TLS_VERIFY=true
SIMULATOR_API_URLS=https://host.docker.internal
SIMULATOR_TLS_VERIFY=false
